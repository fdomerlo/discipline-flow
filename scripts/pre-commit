#!/usr/bin/env bash

SESSION_FILE="SESSION.md"
if [[ ! -f "$SESSION_FILE" ]]; then
    exit 0
fi

STATE=$(grep "^sdd_state:" "$SESSION_FILE" | awk '{print $2}')

# Barrera 1: Prohibido tocar código en fase de planificación
if [[ "$STATE" == "plan" ]]; then
    # Detecta cambios en archivos que no sean Markdown o texto
    STAGED_FILES=$(git diff --cached --name-only | grep -vE '\.md$|\.txt$')
    if [[ -n "$STAGED_FILES" ]]; then
        echo "❌ Bloqueo SDD: Estás en fase 'plan'. El contrato prohíbe modificar código fuente."
        echo "Archivos bloqueados:"
        echo "$STAGED_FILES"
        echo "👉 Usa '/execute <tarea>' o './scripts/sdd.sh start <tarea>' para avanzar."
        exit 1
    fi
fi

exit 0