{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discipline-flow.local/schemas/spec_verification.json",
  "title": "SpecVerification",
  "description": "Deterministic contract validating a specification or PLAN-N.md before execution approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approved",
    "plan_file",
    "objective",
    "commands",
    "boundaries",
    "criteria",
    "out_of_scope",
    "open_questions",
    "missing_sections"
  ],
  "properties": {
    "approved": {
      "type": "boolean",
      "description": "True only if missing_sections is empty, open_questions is empty, and all criteria are testable."
    },
    "plan_file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_.-]+/)?PLAN-[0-9]+(\\.[0-9]+)?\\.md$",
      "description": "Relative path to the audited plan file (e.g. plans/PLAN-1.md)."
    },
    "objective": {
      "type": "string",
      "minLength": 10,
      "description": "Single concise statement of what is being built and why."
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "test", "lint"],
      "properties": {
        "build": {
          "type": "string",
          "minLength": 1,
          "description": "Executable build command or 'none' if interpreted."
        },
        "test": {
          "type": "string",
          "minLength": 1,
          "description": "Executable test runner command."
        },
        "lint": {
          "type": "string",
          "minLength": 1,
          "description": "Executable linter command or 'none'."
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["always", "ask_first", "never"],
      "properties": {
        "always": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "ask_first": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "never": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "description": "Acceptance criteria extracted from the plan/spec.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phase", "description", "type", "testable"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CRIT-[0-9]{2,}$"
          },
          "phase": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "type": {
            "type": "string",
            "enum": ["automated", "manual"]
          },
          "testable": {
            "type": "boolean",
            "description": "Whether the criterion is concrete and falsifiable (not a vague quality claim)."
          }
        }
      }
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Explicitly excluded items to prevent scope creep."
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Unresolved ambiguities or DECISIÓN ABIERTA blocks. Must be empty for approved=true."
    },
    "missing_sections": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Required sections or invariants missing from the specification."
    }
  }
}
