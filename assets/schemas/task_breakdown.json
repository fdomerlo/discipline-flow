{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discipline-flow.local/schemas/task_breakdown.json",
  "title": "TaskBreakdown",
  "description": "Deterministic schema for atomic, dependency-ordered tasks extracted from PLAN-N.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_file", "phase_id", "tasks"],
  "properties": {
    "plan_file": {
      "type": "string",
      "pattern": "^([a-zA-Z0-9_.-]+/)?PLAN-[0-9]+(\\.[0-9]+)?\\.md$"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^F[0-9]+$",
      "description": "Target phase identifier (e.g. F1)."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "title",
          "affected_files",
          "tests_to_create",
          "criteria_ids",
          "dependencies",
          "parallelizable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(F[0-9]+|TASK-[0-9]{2,}|F[0-9]+-T[0-9]+)$",
            "description": "Unique atomic task identifier."
          },
          "phase": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "description": "Concise vertical-slice description without multi-subsystem conjunctions."
          },
          "affected_files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Files to create or modify (strictly capped at 5 files per atomic task)."
          },
          "tests_to_create": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Test functions or test file targets proving the task's criteria."
          },
          "criteria_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CRIT-[0-9]{2,}$"
            },
            "description": "CRIT-XX identifiers satisfied by this task."
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(F[0-9]+|TASK-[0-9]{2,}|F[0-9]+-T[0-9]+)$"
            },
            "description": "Upstream task IDs that must complete before this task starts."
          },
          "parallelizable": {
            "type": "boolean",
            "description": "True if affected_files and state are disjoint from peer tasks at the same DAG level."
          }
        }
      }
    }
  }
}
